{
  "name": "schr1",
  "version": "1.0.0",
  "description": "Website of the fictional carpentry Schreinerei Tannrieder",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "vercel-build": "cross-env NODE_OPTIONS=--no-deprecation payload migrate && next build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation payload run seed/content.ts",
    "reset-admin": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/reset-admin-password.ts",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload"
  },
  "engines": {
    "node": "26.x"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "@payloadcms/db-postgres": "3.93.0",
    "@payloadcms/next": "3.93.0",
    "@payloadcms/richtext-lexical": "3.93.0",
    "@payloadcms/storage-vercel-blob": "3.93.0",
    "@payloadcms/translations": "3.93.0",
    "@payloadcms/ui": "3.93.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@tailwindcss/postcss": "4.3.5",
    "cross-env": "10.1.0",
    "graphql": "16.15.0",
    "gsap": "3.15.1",
    "lenis": "1.3.27",
    "next": "16.4.6",
    "next-intl": "4.15.1",
    "payload": "3.93.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "6.38.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.5",
    "three": "0.187.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.8",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "typescript": "5.7.3",
    "vitest": "5.1.0"
  }
}
