DATABASE_URI=
PAYLOAD_SECRET=
BLOB_READ_WRITE_TOKEN=

# Mail of the forms (src/lib/mail.ts)
# RESEND_API_KEY: the key from resend.com, needed with MAIL_TRANSPORT resend
# MAIL_TO: Maxon's address, the same as the Resend account's
# MAIL_TRANSPORT: "log" writes the mail to the server console (development, tests),
#   "resend" sends it; anything else, or nothing, makes the forms show the phone
RESEND_API_KEY=
MAIL_TO=
MAIL_TRANSPORT=

# Search engines (src/lib/seo.ts)
# NEXT_PUBLIC_SITE_URL: the site's address, such as https://schr1.vercel.app
#   (canonical, hreflang, sitemap, preview images, Google markup)
# SITE_INDEXING: "true" lets search engines in; anything else, or nothing,
#   is the demo: noindex, nofollow on every page, X-Robots-Tag, robots.txt Disallow /
NEXT_PUBLIC_SITE_URL=
SITE_INDEXING=
